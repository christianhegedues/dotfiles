Host github-private
	HostName github.com
        AddKeysToAgent yes
        UseKeychain yes
        IdentitiesOnly yes
        IdentityFile ~/.ssh/id_ed25519

Host github-work
	HostName github.com
        AddKeysToAgent yes
        UseKeychain yes
        IdentitiesOnly yes
        IdentityFile ~/.ssh/id_ed25519_work
